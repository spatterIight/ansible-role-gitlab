{#
  GitLab is configured via `/etc/gitlab/gitlab.rb` (see `gitlab.rb.j2`), not via environment variables.
  The variables below only influence the container's startup script (`/assets/init-container`).
#}
{% if not gitlab_container_logs_tail_enabled %}
GITLAB_SKIP_TAIL_LOGS=true
{% endif %}
{% if not gitlab_ssh_enabled | bool %}
GITLAB_DISABLE_OPENSSH=true
{% endif %}

